{
  "manifest_version": 3,
  "name": "StudyTracker クリッパー",
  "version": "1.2.4",
  "key": "",
  "description": "見ているWebページや選択テキストを StudyTracker の特急メモにサッと記録するクリッパー。",
  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "StudyTracker に記録（選択テキスト／ページ）"
  },
  "commands": {
    "clip-current": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "選択テキスト／このページを StudyTracker に記録"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
